# ===== 大模型配置 =====
# 本项目默认严格 BYOK：使用者在网页右上角「模型设置」里填自己的 key，
# 请求时由后端透传，不落库、不写日志。
#
# 下面这个 key 默认**不会被使用**，只有把 ALLOW_SERVER_KEY 设为 1 时才作为兜底。
# 这样部署者不会因为别人没填 key 而被动消耗自己的额度。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 是否允许回退到上面的服务端公共 key：0 关闭（默认，严格 BYOK）/ 1 开启（仅本地演示用）
ALLOW_SERVER_KEY=0

# ===== 安全 =====
# JWT 签名密钥。留空时首次启动会自动生成 backend/data/.secret_key（已 gitignore），
# 部署到服务器时建议显式设置一个随机值。
SECRET_KEY=

# ===== 本地向量化模型（BGE，无需额外 key） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索返回的相关知识点数量
TOP_K=3

# RAG 向量召回余弦距离上限，需结合课程实测校准（越小越保守）
RAG_MAX_DISTANCE=0.45
# 模型/向量查询失败后的重试冷却秒数
RAG_RETRY_SECONDS=60
# 可选绝对路径，默认使用 backend/data/knowledge 与 backend/data/vector_db
# KNOWLEDGE_DIR=
# VECTOR_DB_DIR=
