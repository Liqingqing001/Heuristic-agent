# ===== 大模型配置 =====
# 服务端公共密钥（可选）。
# 本项目默认 BYOK：使用者在网页右上角「模型设置」里填自己的 key，
# 请求时由后端透传，不落库、不写日志。
# 这里留空也能正常启动；填了则未配置个人 key 的用户会回退到它。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 安全 =====
# JWT 签名密钥。留空时首次启动会自动生成 backend/data/.secret_key（已 gitignore），
# 部署到服务器时建议显式设置一个随机值。
SECRET_KEY=

# ===== 本地向量化模型（BGE，无需额外 key） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索返回的相关知识点数量
TOP_K=3
